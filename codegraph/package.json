{
  "name": "@mcps/codegraph",
  "version": "1.0.0",
  "description": "Ultra-fast, zero-overhead type-resolved symbol and call graph engine for TypeScript/JavaScript codebases. Model Context Protocol (MCP) server & CLI with memory-mapped query views and incremental kernel watching.",
  "type": "module",
  "main": "query-client.mjs",
  "bin": {
    "codegraph": "./cli.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "codegraph",
    "code-intelligence",
    "symbol-graph",
    "call-graph",
    "ast",
    "typescript",
    "javascript",
    "codebase-indexing",
    "dependency-graph",
    "dead-code-detection",
    "developer-tools",
    "ai-agent",
    "llm-tools",
    "claude-mcp",
    "gemini-mcp",
    "mmap",
    "fsevents",
    "inotify"
  ],
  "author": "Robert Wlaschin <raw77_m@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwlaschin/mcps.git",
    "directory": "codegraph"
  },
  "bugs": {
    "url": "https://github.com/rwlaschin/mcps/issues"
  },
  "homepage": "https://github.com/rwlaschin/mcps/tree/main/codegraph#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "install": "node native/build-optional.mjs",
    "build:native": "node-gyp rebuild",
    "index": "node tool.mjs build",
    "mcp": "node mcp.mjs",
    "watch": "node mcp.mjs",
    "visualize": "node visualizer.mjs",
    "visualize:watch": "node --watch-path=visualizer.mjs --watch-path=visualizer-graph.mjs --watch-path=indexer.mjs --watch-path=query-client.mjs --watch-path=tool.mjs visualizer.mjs",
    "dev": "node --watch-path=visualizer.mjs --watch-path=visualizer-graph.mjs --watch-path=indexer.mjs --watch-path=query-client.mjs --watch-path=tool.mjs visualizer.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@ts-morph/common": "^0.29.0",
    "chokidar": "^4.0.3",
    "minimatch": "^10.2.6",
    "ts-morph": "^28.0.0"
  }
}
